# Proyecto de Google Cloud donde corre el agente (Agent Registry, Firestore, Cloud Run)
SEO_AGENT_PROJECT_ID=your-gcp-project
SEO_AGENT_LOCATION=us-central1

# Service account del agente (Sheets y Google Chat se usan suplantándola)
SEO_AGENT_SERVICE_ACCOUNT=seo-programmatic-agent@your-gcp-project.iam.gserviceaccount.com

# Servidor MCP de Search Console registrado en Agent Registry
SEO_AGENT_SEARCH_CONSOLE_MCP=search-console-readonly

# Vertex AI (por defecto, el mismo proyecto)
# SEO_AGENT_VERTEX_PROJECT=your-gcp-project
# SEO_AGENT_VERTEX_LOCATION=us-central1

# Google Chat: número de proyecto (o URL del endpoint) como audiencia del token
SEO_AGENT_CHAT_AUDIENCE=123456789012

# Estado: firestore (producción) o json (desarrollo local)
SEO_AGENT_STATE_BACKEND=json

# Opcional: Memory Bank de Vertex AI
# SEO_AGENT_AGENT_ENGINE_ID=

# Tests --live
# SEO_AGENT_TEST_SHEET_ID=
# SEO_AGENT_LIVE_SITE=www.tu-sitio.cl
